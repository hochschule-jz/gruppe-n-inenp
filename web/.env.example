# Public utilization endpoint for the Modell (live sensor) view.
# Not a secret — the API is public and CORS is open — this is per-deployment config.
#
# Get the value from the deployed stack:
#   aws cloudformation describe-stacks --stack-name drive-and-decide --region us-east-1 \
#     --query "Stacks[0].Outputs[?OutputKey=='ApiUrl'].OutputValue" --output text
#
# Copy this file to .env.local and fill in the real id. Leaving it unset makes the
# Modell view show "Nicht konfiguriert" (the Großgarage simulation still works).
VITE_API_URL=https://YOUR_API_ID.execute-api.us-east-1.amazonaws.com/garages/garage1/utilization
