# Public API base URL for the live views (Modell = garage1, Großgarage = garage2).
# Not a secret — the API is public and CORS is open — this is per-deployment config.
#
# Get the value from the deployed stack:
#   aws cloudformation describe-stacks --stack-name drive-and-decide --region us-east-1 \
#     --query "Stacks[0].Outputs[?OutputKey=='ApiBase'].OutputValue" --output text
#
# Copy this file to .env.local and fill in the real id. Leaving it unset makes both
# views show "Nicht konfiguriert". No trailing slash; the app appends
# /garages/{garageId}/utilization itself.
VITE_API_BASE=https://YOUR_API_ID.execute-api.us-east-1.amazonaws.com
